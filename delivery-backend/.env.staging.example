# Entorno de Staging / Pre-producción (.env.staging)
PORT=3000
NODE_ENV=staging
ALLOWED_ORIGINS=https://staging.tuapp.com
MONGO_URI=mongodb+srv://user:password@staging-cluster.mongodb.net/delivery-staging
REDIS_URL=redis://staging-redis:6379
JWT_SECRET=staging_super_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=staging_refresh_secret_minimum_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
