# Entorno de Producción (.env.production)
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://tuapp.com,https://www.tuapp.com
MONGO_URI=mongodb+srv://prod_user:strong_password@prod-cluster.mongodb.net/delivery
REDIS_URL=redis://prod-elasticache.amazonaws.com:6379
JWT_SECRET=prod_super_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=prod_refresh_secret_minimum_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
