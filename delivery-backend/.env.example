# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Database
MONGO_URI=mongodb://admin:admin123@localhost:27017/delivery?authSource=admin

# Redis (Cache & BullMQ Queues)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Default Admin Seed
ADMIN_EMAIL=admin@delivery.com
ADMIN_PASSWORD=AdminPassword123!
