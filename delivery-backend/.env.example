# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Database
MONGO_URI=mongodb://admin:admin123@localhost:27017/delivery?authSource=admin

# Redis (Cache & BullMQ Queues)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Default Admin Seed
ADMIN_EMAIL=admin@delivery.com
ADMIN_PASSWORD=AdminPassword123!

# Frontend URL (para enlaces de verificación de correo)
FRONTEND_URL=http://localhost:5173

# Correo SMTP opcional (si se omiten, se usa Nodemailer Ethereal en desarrollo)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_app_password
# MAIL_FROM=DeliveryPro <noreply@deliverypro.com>

# OAuth 2.0 Social (Google Cloud Console & Meta for Developers)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMS Verificación (Twilio Verify API recomendado — funciona en cuenta Trial y producción)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Opcional: Programmable SMS clásico (solo cuentas Twilio pagas sin Verify Service)
TWILIO_FROM_NUMBER=

# AWS S3 & CloudFront CDN (opcional: dominio CloudFront para servir imágenes en producción)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_DOMAIN=
